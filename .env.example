# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional 32-byte hex or passphrase used for AES-256-GCM encryption of integration credentials at rest.
# If empty, a random key is created once in "integration.key" next to the database (keep it with your backups,
# but note that whoever has both files can decrypt the credentials; set this variable to keep the key elsewhere).
INTEGRATION_ENCRYPTION_KEY=""

# Optional PocketBase server URL to sync integration collections (e.g. http://127.0.0.1:8090).
POCKETBASE_URL=""


# ---- Backend (P0: persistence, authentication, audit) ----
# SQLite database file. Defaults to ./.data/jiraflow.db (WAL mode). Back this file up.
JIRAFLOW_DB_PATH=""

# First-start seeding. In development (NODE_ENV != production) every seeded user gets the demo password
# "password123" and the sign-in page offers quick-login cards. In production the demo accounts are NOT
# usable: either set SEED_DEFAULT_PASSWORD (users must change it at first sign-in) or leave it empty and
# copy the one-time administrator password printed in the server log on first start.
SEED_DEFAULT_PASSWORD=""

# Set when running behind a reverse proxy so client IPs (rate limiting, audit log) are correct, e.g. "1".
TRUST_PROXY=""
# Force the Secure flag on the session cookie ("true"/"false"). Defaults to on in production.
COOKIE_SECURE=""
# Allow admins to reset the workspace to demo data in production (disabled by default).
ALLOW_DEMO_RESET=""

# ---- P1: attachments, notifications, automation ----
# Uploaded attachment files are stored next to the database in ./.data/uploads (override with the folder below).
JIRAFLOW_UPLOAD_DIR=""
# Maximum attachment size in MB (default 25).
MAX_UPLOAD_MB=""
# Optional email delivery for notifications, e.g. smtp://user:pass@smtp.example.com:587 (unset = in-app only).
SMTP_URL=""
MAIL_FROM="JiraFlow <no-reply@example.com>"
# Automation webhooks must use https and may not target private/loopback addresses. Set to "true" ONLY in
# development/tests to allow http://localhost targets.
AUTOMATION_ALLOW_PRIVATE_WEBHOOKS=""

# ---- P3: integrations ----
# Integrations may not connect to private/loopback addresses. Set to "true" for a Jira / Confluence / GitHub /
# GitLab server on your own network (this also allows localhost), or for tests.
INTEGRATIONS_ALLOW_PRIVATE_HOSTS=""
# Where to keep the generated credential key (default: next to the database).
INTEGRATION_KEY_FILE=""
# How often each connection is health-checked, in milliseconds (default 300000).
INTEGRATION_HEALTH_INTERVAL_MS=""
# How often connected repositories are polled, in minutes (default 15). Webhooks update them in between.
SCM_SYNC_INTERVAL_MINUTES=""
# Comma separated names of production environments. Default: names starting with prod, production or live.
SCM_PRODUCTION_ENVIRONMENTS=""
# Delay before a local edit of a two-way synced record is pushed, in milliseconds (default 2000).
INTEGRATION_PUSH_DELAY_MS=""
# Longest time a request waits for a rate limit to clear before the job is rescheduled (default 8000 ms).
INTEGRATION_MAX_INLINE_WAIT_MS=""
